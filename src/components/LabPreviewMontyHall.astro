---
// Static, byte-stable preview for the Monty Hall lab card. The frozen
// "redistribution" moment: your box stays 1/3, the host opens an empty box
// (0), and its share flows onto the remaining box → 2/3. Mirrors the lab's
// chips + boxes; teal = your/standing share, coral = the opened empty box.
// No randomness — fully deterministic geometry.

const W = 320;
const H = 200;
const bw = 62;
const bh = 58;
const gap = 30;
const startX = (W - (3 * bw + 2 * gap)) / 2;              // 37
const bx = [0, 1, 2].map((i) => startX + i * (bw + gap)); // [37, 129, 221]
const cx = bx.map((x) => x + bw / 2);                     // [68, 160, 252]
const by = 86;                 // box top
const lidY = by + 15;          // lid seam
const chipY = 74;              // probability chip baseline (above boxes)
const labelY = 164;            // under-label baseline
const r = 3;                   // corner radius — design-system max
const midY = by + bh / 2;      // centre of the opened box (for the ×)
const xArm = 11;               // half-size of the × in the opened box
const flowMidX = (cx[1] + cx[2]) / 2;

// Tabler "coins" glyph (v2.47.0 — same icon as the lab), 24×24, inlined and
// centred low in box 3 so the prize box reads at a glance.
const coinScale = 0.9;
const coinX = cx[2] - 12 * coinScale;
const coinY = 120 - 12 * coinScale;
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid meet"
  class="mh-prev"
  aria-hidden="true"
>
  <path
    d={`M ${cx[1]} 52 Q ${flowMidX} 16 ${cx[2]} 52`}
    fill="none"
    stroke="var(--teal)"
    stroke-width="1.3"
    stroke-dasharray="2 2.5"
    stroke-linecap="round"
  />
  <path
    d={`M ${cx[2] - 4} 47 L ${cx[2]} 54 L ${cx[2] + 4} 47`}
    fill="none"
    stroke="var(--teal)"
    stroke-width="1.3"
    stroke-linejoin="round"
    stroke-linecap="round"
  />
  <text x={flowMidX} y="14" text-anchor="middle" class="mh-flow">1/3</text>

  <text x={cx[0]} y={chipY} text-anchor="middle" class="mh-chip is-teal">1/3</text>
  <text x={cx[1]} y={chipY} text-anchor="middle" class="mh-chip is-coral">0</text>
  <text x={cx[2]} y={chipY} text-anchor="middle" class="mh-chip is-teal is-strong">2/3</text>

  <rect x={bx[0]} y={by} width={bw} height={bh} rx={r} fill="none" stroke="var(--teal)" stroke-width="2" />
  <line x1={bx[0] + 5} x2={bx[0] + bw - 5} y1={lidY} y2={lidY} stroke="var(--teal)" stroke-width="1.4" />

  <rect x={bx[1]} y={by} width={bw} height={bh} rx={r} fill="none" stroke="var(--coral)" stroke-width="1.6" stroke-opacity="0.7" stroke-dasharray="3 3" />
  <line x1={cx[1] - xArm} y1={midY - xArm} x2={cx[1] + xArm} y2={midY + xArm} stroke="var(--coral)" stroke-width="1.8" stroke-linecap="round" />
  <line x1={cx[1] + xArm} y1={midY - xArm} x2={cx[1] - xArm} y2={midY + xArm} stroke="var(--coral)" stroke-width="1.8" stroke-linecap="round" />

  <rect x={bx[2]} y={by} width={bw} height={bh} rx={r} fill="var(--teal)" fill-opacity="0.06" stroke="var(--teal)" stroke-width="2.6" />
  <line x1={bx[2] + 5} x2={bx[2] + bw - 5} y1={lidY} y2={lidY} stroke="var(--teal)" stroke-width="1.6" />
  <g transform={`translate(${coinX} ${coinY}) scale(${coinScale})`} fill="none" stroke="var(--teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 14c0 1.657 2.686 3 6 3s6 -1.343 6 -3s-2.686 -3 -6 -3s-6 1.343 -6 3z" />
    <path d="M9 14v4c0 1.656 2.686 3 6 3s6 -1.344 6 -3v-4" />
    <path d="M3 6c0 1.072 1.144 2.062 3 2.598s4.144 .536 6 0c1.856 -.536 3 -1.526 3 -2.598c0 -1.072 -1.144 -2.062 -3 -2.598s-4.144 -.536 -6 0c-1.856 .536 -3 1.526 -3 2.598z" />
    <path d="M3 6v10c0 .888 .772 1.45 2 2" />
    <path d="M3 11c0 .888 .772 1.45 2 2" />
  </g>

  <text x={cx[0]} y={labelY} text-anchor="middle" class="mh-cap">твоя</text>
  <text x={cx[1]} y={labelY} text-anchor="middle" class="mh-cap">вскрыта</text>
  <text x={cx[2]} y={labelY} text-anchor="middle" class="mh-cap">осталась</text>
</svg>

<style>
  .mh-prev {
    width: 100%;
    height: 100%;
    display: block;
  }
  .mh-chip {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 13px;
  }
  .mh-chip.is-teal { fill: var(--teal); }
  .mh-chip.is-coral { fill: var(--coral); }
  .mh-chip.is-strong { font-size: 16px; font-weight: 500; }
  .mh-flow {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 10px;
    fill: var(--teal);
  }
  .mh-cap {
    font-family: var(--font);
    font-size: 9px;
    fill: var(--ink-faint);
  }
</style>
