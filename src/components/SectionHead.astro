---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="section-head">
  <span class="rule" aria-hidden="true"></span>
  <h2>{title}</h2>
</header>

<style>
  .section-head {
    margin-top: 64px;
  }
  .rule {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--teal);
    margin-bottom: 14px;
  }
  .section-head h2 {
    margin: 0;
  }
</style>
