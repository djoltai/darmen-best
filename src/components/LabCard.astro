---
interface Props {
  href: string;
  tag: string;
  title: string;
  body: string;
  cta?: string;
}
const { href, tag, title, body, cta = 'Читать →' } = Astro.props;
---

<a href={href} class="lab-card">
  <div class="chart-wrap">
    <slot />
  </div>

  <div class="copy">
    <div class="tag">{tag}</div>
    <h3 class="title">{title}</h3>
    <p class="body">{body}</p>
    <div class="cta">{cta}</div>
  </div>
</a>

<style>
  .lab-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 32px;
    background: var(--bg-elev);
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    align-items: center;
    transition: background-color var(--t-fast);
  }
  .lab-card:hover {
    background: #ECE5C5;
    color: var(--ink);
    border-bottom-color: transparent;
  }
  .chart-wrap {
    aspect-ratio: 16 / 10;
    width: 100%;
  }
  .tag {
    font-size: var(--t-tag);
    letter-spacing: var(--track-tag);
    color: var(--ink-muted);
    text-transform: lowercase;
  }
  .title {
    margin-top: 12px;
    font-size: 28px;
    font-weight: var(--w-medium);
    letter-spacing: -0.025em;
    line-height: var(--lh-tight);
  }
  .body {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .cta {
    margin-top: 24px;
    font-size: 14px;
    color: var(--teal);
    font-weight: var(--w-medium);
  }

  @media (max-width: 640px) {
    .lab-card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }
    .title { font-size: 24px; }
  }
</style>
